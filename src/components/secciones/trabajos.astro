---
// Proyectos (obra terminada): banda grafito con el titular y, debajo, un mosaico de fotos de borde a borde sin
// margen. Las piezas crecen hasta llenar cada fila (sin huecos con cualquier número de obras); la primera de cada
// cuatro es más ancha. Sobre cada foto: categoría, título, lugar · año y, en escritorio, el texto.
// Campos: trabajos[] {titulo, texto, lugar, anio, categoria, imagen}; cta opcional bajo el mosaico.
import { seccion, numeroSeccion } from '../../data/site';
import type { Trabajo } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
// Diseño reutilizable: con `tipo: trabajos` y la lista en `proyectos`, también sirve.
const lista: Trabajo[] = s
  ? ((s.trabajos.length ? s.trabajos : (s.proyectos as unknown as Trabajo[])) ?? []).filter((t) => t && t.titulo)
  : [];
---

{
  s && (
    <section id={id} class="banda-grafito fondo-oscuro hormigon-oscuro">
      <div class="contenedor pb-12 pt-[var(--ritmo)] md:pb-16 md:pt-[var(--ritmo-md)]">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <Titular class="mb-0 lg:col-span-7" numero={numeroSeccion(id)} antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="titular-texto mt-0 lg:col-span-5 lg:pb-2">{s.texto}</p>}
        </div>
      </div>
      {lista.length > 0 && (
        <ul class="mosaico">
          {lista.map((t) => (
            <li class="pieza group">
              <Imagen src={t.imagen || '/placeholders/obra.svg'} alt={t.titulo} ancho={1000} alto={750} respaldo="/placeholders/obra.svg" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              <div class="pieza-velo absolute inset-0" aria-hidden="true" />
              <div class="relative mt-auto p-4 sm:p-6">
                {t.categoria && <p class="estado">{t.categoria}</p>}
                <h3 class="mt-3 text-[1.6rem] leading-none text-white md:text-[1.9rem]">{t.titulo}</h3>
                {(t.lugar || t.anio) && (
                  <p class="dato-tecnico mt-2 uppercase text-white/80">{[t.lugar, t.anio].filter(Boolean).join(' · ')}</p>
                )}
                {t.texto && <p class="pieza-texto mt-3 max-w-md text-sm text-white/85">{t.texto}</p>}
              </div>
            </li>
          ))}
        </ul>
      )}
      {s.cta?.url && (
        <div class="contenedor py-10">
          <a class="btn-acento" href={s.cta.url}>{s.cta.texto}<Icono nombre="flecha" tam={18} class="flecha" /></a>
        </div>
      )}
    </section>
  )
}

<style>
  .mosaico { display: flex; flex-wrap: wrap; }
  .pieza { position: relative; isolation: isolate; display: flex; flex-direction: column; flex: 1 1 100%; min-height: 20rem; overflow: hidden; background: var(--c-grafito-2); }
  .pieza-velo { background: linear-gradient(0deg, rgb(0 0 0 / .78) 0%, rgb(0 0 0 / .25) 50%, transparent 75%); }
  .pieza-texto { display: none; }
  @media (min-width: 640px) {
    .pieza { flex-basis: 50%; min-height: 22rem; }
  }
  @media (min-width: 1024px) {
    .pieza { flex-basis: 25%; min-height: 28rem; }
    .pieza:nth-child(4n + 1) { flex-basis: 50%; }
    .pieza-texto { display: block; }
  }
</style>
