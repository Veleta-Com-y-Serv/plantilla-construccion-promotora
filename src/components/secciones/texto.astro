---
// Apartado de texto genérico (apartados nuevos del cliente, `tipo: texto`): banda blanca; con imagen, fila 50/50 con
// la foto a sangre a la izquierda; sin imagen, el texto a 90 rem en dos columnas (titular y párrafos).
// Campos: antetitulo, titulo, texto (párrafos separados por línea en blanco), imagen, items[] {titulo, texto, icono}, cta.
import { seccion, parrafos, numeroSeccion } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const items = s ? s.items.filter((i) => i.titulo) : [];
---

{
  s && (
    <section id={id} class:list={['bg-fondo', s.imagen && 'grid lg:grid-cols-2']}>
      {s.imagen && (
        <div class="relative min-h-[15rem] overflow-hidden sm:min-h-[22rem] lg:min-h-[32rem]">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} respaldo="/placeholders/obra.svg" class="absolute inset-0 h-full w-full object-cover" />
        </div>
      )}
      <div class:list={['py-[var(--ritmo)] md:py-[var(--ritmo-md)]', s.imagen ? 'px-4 sm:px-8 lg:px-16' : 'contenedor grid gap-10 lg:grid-cols-12']}>
        <Titular class:list={['mb-0', !s.imagen && 'lg:col-span-5']} numero={numeroSeccion(id)} antetitulo={s.antetitulo} titulo={s.titulo} />
        <div class:list={[!s.imagen && 'lg:col-span-7', s.imagen && 'mt-8 max-w-[40rem]']}>
          <div class="space-y-4 text-lg text-[var(--c-tenue)]">
            {parrafos(s.texto).map((p) => <p>{p}</p>)}
          </div>
          {items.length > 0 && (
            <ul class="mt-8 border-t-2 border-texto">
              {items.map((it) => (
                <li class="flex gap-4 border-b border-[var(--c-borde)] py-4">
                  <Icono nombre={it.icono || 'check'} tam={22} class="mt-0.5 shrink-0 text-[var(--c-acento-texto)]" />
                  <div>
                    <p class="font-bold">{it.titulo}</p>
                    {it.texto && <p class="text-[var(--c-tenue)]">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <a class="btn mt-8" href={s.cta.url}>{s.cta.texto}<Icono nombre="flecha" tam={18} class="flecha" /></a>}
        </div>
      </div>
    </section>
  )
}
