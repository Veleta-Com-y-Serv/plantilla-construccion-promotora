---
// Contacto partido 50/50 a sangre: a la izquierda, banda de acero con el titular, el teléfono en grande y los datos
// de la oficina; a la derecha, banda grafito con el formulario (mailto). «Me interesa» sale de `opciones`
// (cadena separada por «;»); si está vacía, de los accesos de la portada (hero.items).
import { seccion, site, tel, mapa, whatsapp, numeroSeccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const desdeTexto = typeof s?.opciones === 'string' ? s.opciones.split(';').map((o) => o.trim()).filter(Boolean) : [];
const opciones = desdeTexto.length ? desdeTexto : (site.secciones.hero?.items ?? []).map((i) => i.titulo).filter(Boolean);
const datos = [
  c.whatsapp && { icono: 'whatsapp', etiqueta: 'WhatsApp', valor: c.whatsapp, url: whatsapp(c.whatsapp) },
  c.email && { icono: 'correo', etiqueta: 'Email', valor: c.email, url: `mailto:${c.email}` },
  c.direccion && { icono: 'mapa', etiqueta: 'Oficina', valor: c.direccion, url: mapa(c.direccion) },
  c.horario && { icono: 'reloj', etiqueta: 'Horario', valor: c.horario, url: '' },
].filter(Boolean) as { icono: string; etiqueta: string; valor: string; url: string }[];
---

{
  s && (
    <section id={id} class="grid lg:grid-cols-2">
      <div class="banda-acero fondo-oscuro relative isolate flex justify-end px-4 py-16 sm:px-8 md:py-24 lg:px-16">
        <div class="hormigon-oscuro absolute inset-0 -z-10 opacity-60" aria-hidden="true" />
        <div class="w-full max-w-[40rem]">
          <Titular class="mb-0" numero={numeroSeccion(id)} antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {c.telefono && (
            <a href={tel(c.telefono)} class="mt-10 inline-flex items-center gap-4 no-underline" aria-label={`Llamar al ${c.telefono}`}>
              <span class="icono-bloque bg-acento text-[var(--c-sobre-acento)] shadow-[6px_6px_0_rgb(0_0_0/.3)]"><Icono nombre="telefono" tam={24} /></span>
              <span class="font-display text-[clamp(1.9rem,4.4vw,3.5rem)] font-black leading-none tracking-tight">{c.telefono}</span>
            </a>
          )}
          {datos.length > 0 && (
            <dl class="mt-10 grid gap-x-8 gap-y-6 border-t border-white/20 pt-8 sm:grid-cols-2">
              {datos.map((d) => (
                <div class="flex min-w-0 gap-3">
                  <Icono nombre={d.icono} tam={20} class="mt-0.5 shrink-0 text-acento" />
                  <div class="min-w-0">
                    <dt class="dato-tecnico text-xs uppercase tracking-[.14em] text-white/60">{d.etiqueta}</dt>
                    <dd class="mt-1 break-words font-semibold">{d.url ? <a href={d.url} class="hover:text-acento">{d.valor}</a> : d.valor}</dd>
                  </div>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
      <div class="bg-[var(--c-grafito-2)] px-4 py-16 text-white sm:px-8 md:py-24 lg:px-16">
        <div class="w-full max-w-[40rem]">
          <FormularioContacto boton={s.cta?.texto || 'Enviar'} opciones={opciones} />
        </div>
      </div>
    </section>
  )
}
