---
// Cómo trabajamos: banda blanca con las fases como un cronograma de obra. En escritorio, columnas unidas por una
// viga de acero con un nudo cuadrado por fase; en móvil, la viga es vertical a la izquierda.
// Campos: items[] {titulo, texto, icono}; cta opcional.
import { seccion, numeroSeccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const pasos = s ? s.items.filter((i) => i.titulo) : [];
---

{
  s && (
    <section id={id} class="bg-fondo">
      <div class="contenedor py-[var(--ritmo)] md:py-[var(--ritmo-md)]">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <Titular class="mb-0 lg:col-span-7" numero={numeroSeccion(id)} antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="titular-texto mt-0 lg:col-span-5 lg:pb-2">{s.texto}</p>}
        </div>
        {pasos.length > 0 && (
          <ol class="crono mt-14 md:mt-20" style={`--pasos:${pasos.length}`}>
            {pasos.map((p, i) => (
              <li class="fase">
                <span class="fase-nudo" aria-hidden="true" />
                <div class="flex items-center gap-4">
                  <span class="font-display text-5xl font-black leading-none tracking-tighter text-primario md:text-6xl">{String(i + 1).padStart(2, '0')}</span>
                  {p.icono && <Icono nombre={p.icono} tam={28} class="text-[var(--c-acento-texto)]" />}
                </div>
                <h3 class="mt-4 text-xl leading-tight md:text-2xl">{p.titulo}</h3>
                {p.texto && <p class="mt-2 text-[var(--c-tenue)]">{p.texto}</p>}
              </li>
            ))}
          </ol>
        )}
        {s.cta?.url && <a class="btn mt-12" href={s.cta.url}>{s.cta.texto}<Icono nombre="flecha" tam={18} class="flecha" /></a>}
      </div>
    </section>
  )
}

<style>
  .crono { display: grid; gap: 2.5rem; position: relative; padding-left: 2.25rem; }
  .crono::before { content: ""; position: absolute; left: .55rem; top: .5rem; bottom: .5rem; width: 6px; background: var(--c-primario); }
  .fase { position: relative; }
  .fase-nudo { position: absolute; left: -2.25rem; top: .6rem; width: 1.35rem; height: 1.35rem; background: var(--c-acento); border: 4px solid var(--c-fondo); outline: 2px solid var(--c-primario); }
  @media (min-width: 1024px) {
    .crono { grid-template-columns: repeat(var(--pasos), minmax(0, 1fr)); gap: 2rem; padding-left: 0; padding-top: 3rem; }
    .crono::before { left: 0; right: 0; top: .55rem; bottom: auto; width: auto; height: 6px; }
    .fase-nudo { left: 0; top: -3rem; }
  }
</style>
