---
// Equipo: banda de hormigón; retratos 3:4 a 4 columnas en escritorio (2 en móvil) con zócalo de acero,
// nombre en palo seco negro, cargo en monoespaciada y una línea de texto. Campos: personas[] {nombre, cargo, foto, texto}.
import { seccion, numeroSeccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const personas = s ? s.personas.filter((p) => p && p.nombre) : [];
---

{
  s && (
    <section id={id} class="hormigon">
      <div class="contenedor py-[var(--ritmo)] md:py-[var(--ritmo-md)]">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <Titular class="mb-0 lg:col-span-7" numero={numeroSeccion(id)} antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="titular-texto mt-0 lg:col-span-5 lg:pb-2">{s.texto}</p>}
        </div>
        {personas.length > 0 && (
          <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:mt-16 md:gap-x-8 lg:grid-cols-4">
            {personas.map((p) => (
              <li>
                <div class="persona-foto relative overflow-hidden bg-[var(--c-hormigon-2)]">
                  <Imagen src={p.foto || '/placeholders/persona.svg'} alt={p.nombre} ancho={600} alto={800} respaldo="/placeholders/persona.svg" class="aspect-[3/4] w-full object-cover grayscale-[35%]" />
                </div>
                <h3 class="mt-5 text-lg leading-tight sm:text-2xl">{p.nombre}</h3>
                {p.cargo && <p class="dato-tecnico mt-2 uppercase text-[var(--c-acento-texto)]">{p.cargo}</p>}
                {p.texto && <p class="mt-2 hidden text-[var(--c-tenue)] sm:block">{p.texto}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .persona-foto { border-bottom: 8px solid var(--c-primario); }
  .persona-foto::after { content: ""; position: absolute; left: 0; bottom: 0; width: 30%; height: 8px; transform: translateY(8px); background: var(--c-acento); }
</style>
