---
// Ficha de una promoción con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /promociones/<slug>/.
// Diseño «obra»: banda grafito con berenjenos, migas y hero partido (título en palo seco negro, estado, lugar y precio,
// botones macizos; a la derecha la foto de esquinas vivas o, sin foto, el icono en un bloque de acero); banda blanca con
// el `detalle` y, al lado, la tabla de datos entre filetes gruesos y la caja de acero de contacto; fotos (`imagenes`)
// en banda hormigón; y otras promociones de la misma lista en banda blanca con tarjetas de borde grueso.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { clave, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = site.boton_cabecera?.url || enlace('/#contacto');
const textoContacto = site.boton_cabecera?.texto || 'Pide información';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const dato = (k: string) => f.datos.find((d) => d.clave === k)?.valor ?? '';
const estado = dato('estado');
const lugar = dato('lugar');
const etiquetas: Record<string, string> = { tipologia: 'Tipología', viviendas: 'Viviendas' };
const datos = f.datos.filter((d) => !['precio', 'estado', 'lugar'].includes(d.clave)).map((d) => ({ ...d, etiqueta: etiquetas[d.clave] ?? d.etiqueta }));
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-grafito hormigon-oscuro fondo-oscuro ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          {estado && <p><span class:list={['estado', `estado--${clave(estado)}`]}>{estado}</span></p>}
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {lugar && (
            <p class="dato-tecnico ficha-lugar"><Icono nombre="mapa" tam={16} class="shrink-0" /> {lugar}</p>
          )}
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn-acento" href={contacto}>{textoContacto}<Icono nombre="flecha" tam={18} class="flecha" /></a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad respaldo="/placeholders/obra.svg" class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><span class="icono-bloque"><Icono nombre={f.icono || 'edificio'} tam={56} /></span></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion bg-fondo">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">Ficha técnica</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio-dato">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja banda-acero">
          <p class="ficha-caja-titulo">¿Quieres verla?</p>
          <p class="opacity-85">Te enseñamos la obra, la memoria de calidades y las viviendas que quedan.</p>
          <a class="btn-acento" href={contacto}>{textoContacto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="hormigon seccion" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} respaldo="/placeholders/obra.svg" class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion bg-fondo">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras promociones" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="icono-bloque"><Icono nombre={o.icono || 'edificio'} tam={24} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio-dato">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn" href={rutaDeSeccion(f.idSeccion)}>Ver todas las promociones</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-family: var(--fuente-tecnica); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; opacity: .5; }
  .migas a { color: var(--c-acento); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.2rem, 6vw, 4.5rem); overflow-wrap: anywhere; }
  .ficha-lugar { display: flex; align-items: center; gap: .5rem; margin-top: 1.25rem; text-transform: uppercase; color: var(--c-acento); }
  .ficha-precio { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-weight: 900; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.02em; color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; text-decoration: none; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-grafito-2); border-bottom: 6px solid var(--c-acento); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--c-grafito-2); border-bottom: 6px solid var(--c-acento); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.25rem; margin-bottom: 1rem; text-transform: uppercase; }
  .ficha-datos { border-block: 2px solid var(--c-texto); padding-block: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--c-borde); }
  .ficha-datos dt { font-family: var(--fuente-tecnica); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; opacity: .75; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-precio-dato { font-family: var(--fuente-titulos); font-weight: 900; color: var(--c-primario); }
  .ficha-caja { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; box-shadow: 8px 8px 0 var(--c-acento); }
  .ficha-caja-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 900; line-height: 1.05; text-transform: uppercase; }
  .ficha-caja .btn-acento { text-decoration: none; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-family: var(--fuente-tecnica); font-weight: 700; color: #fff; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .8rem; padding: 1.5rem; background: var(--c-fondo); border: 2px solid var(--c-texto); transition: transform .15s ease, box-shadow .15s ease; }
  .ficha-otra:hover { box-shadow: 6px 6px 0 var(--c-acento); transform: translate(-2px, -2px); }
  .ficha-otra h3 { font-size: 1.35rem; margin-top: .35rem; overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: 3px; }
  .ficha-otra-texto { color: var(--c-tenue); }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-family: var(--fuente-tecnica); font-weight: 700; text-transform: uppercase; color: var(--c-acento-texto); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 7rem; }
  }
</style>
